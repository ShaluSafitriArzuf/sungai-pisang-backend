# =============================================================================
# CONTOH KONFIGURASI UNTUK HOSTING (PRODUCTION)
# =============================================================================
# Berkas ini BUKAN untuk dijalankan langsung. Salin isinya ke berkas .env di server
# hosting, lalu ganti setiap nilai bertanda GANTI dengan data yang sebenarnya.
#
# JANGAN pernah mengunggah berkas .env yang sudah terisi ke GitHub.
# =============================================================================

APP_NAME="Jelajah Bahari Sungai Pisang"

# WAJIB: production, bukan local
APP_ENV=production

# WAJIB: false. Jika true, setiap error akan menampilkan isi berkas program, query
# basis data, dan sebagian isi .env kepada pengunjung.
APP_DEBUG=false

# Dibuat ulang di server dengan perintah: php artisan key:generate
APP_KEY=

# Alamat backend setelah di-hosting
APP_URL=https://GANTI-DOMAIN-BACKEND

# Zona waktu mengikuti config/app.php (Asia/Jakarta), tidak perlu diatur di sini.

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# BASIS DATA — isi sesuai data dari panel hosting
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=GANTI-HOST-DATABASE
DB_PORT=3306
DB_DATABASE=GANTI-NAMA-DATABASE
DB_USERNAME=GANTI-USER-DATABASE
DB_PASSWORD=GANTI-PASSWORD-DATABASE

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Foto akomodasi, galeri, dan titik kumpul disimpan sebagai berkas pada disk "public".
# Setelah deploy, WAJIB menjalankan: php artisan storage:link
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# EMAIL — dipakai untuk verifikasi email dan reset password
# ---------------------------------------------------------------------------
# Gunakan App Password Gmail, bukan kata sandi akun. Buat yang BARU untuk server,
# terpisah dari yang dipakai saat pengembangan.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=GANTI-EMAIL-PENGIRIM
MAIL_PASSWORD=GANTI-APP-PASSWORD-BARU
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=GANTI-EMAIL-PENGIRIM
MAIL_FROM_NAME="Jelajah Bahari Sungai Pisang"

# ---------------------------------------------------------------------------
# ALAMAT FRONTEND
# ---------------------------------------------------------------------------
# Dipakai untuk: tautan reset password, pengalihan setelah login Google, dan
# daftar domain yang diizinkan pada config/cors.php.
# Tulis TANPA garis miring di akhir.
FRONTEND_URL=https://GANTI-DOMAIN-FRONTEND

# ---------------------------------------------------------------------------
# LOGIN GOOGLE
# ---------------------------------------------------------------------------
# Setelah domain berganti, alamat callback di bawah WAJIB didaftarkan ulang pada
# Google Cloud Console > Credentials > Authorized redirect URIs. Jika tidak,
# tombol "Masuk dengan Google" akan menampilkan galat redirect_uri_mismatch.
#
# Disarankan membuat OAuth Client ID BARU khusus production, agar kredensial yang
# dipakai saat pengembangan tidak ikut terekspos.
GOOGLE_CLIENT_ID=GANTI-CLIENT-ID
GOOGLE_CLIENT_SECRET=GANTI-CLIENT-SECRET
GOOGLE_REDIRECT_URI=https://GANTI-DOMAIN-BACKEND/api/auth/google/callback

# ── Akun asli Pengantar & Pengelola Pulau (dipakai oleh seeder) ──────────────
# Isi di berkas .env, JANGAN di berkas contoh ini.
SEED_PENGANTAR_EMAIL=
SEED_PENGANTAR_PASSWORD=

SEED_PENGELOLA_PASUMPAHAN_EMAIL=
SEED_PENGELOLA_PASUMPAHAN_PASSWORD=

SEED_PENGELOLA_SIRANDAH_EMAIL=
SEED_PENGELOLA_SIRANDAH_PASSWORD=

SEED_PENGELOLA_UJUNG_KAPURI_EMAIL=
SEED_PENGELOLA_UJUNG_KAPURI_PASSWORD=

SEED_PENGELOLA_PAGANG_EMAIL=
SEED_PENGELOLA_PAGANG_PASSWORD=

SEED_PENGELOLA_PAMUTUSAN_EMAIL=
SEED_PENGELOLA_PAMUTUSAN_PASSWORD=

# Kunci RAHASIA reCAPTCHA v2 — jangan pernah dibagikan atau masuk ke kode frontend.
# Kalau dikosongkan, verifikasi captcha dilewati (lihat AuthController::captchaSah).
RECAPTCHA_SECRET=
